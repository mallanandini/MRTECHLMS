# =====================================================================
# MRTECHLMS Environment Configuration Template
# Copy this file to .env and configure values for your environment:
#   copy .env.example .env
# =====================================================================

# Server Port & Mode
PORT=3000
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini AI API calls and AI course generator
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this application is hosted
APP_URL="http://localhost:3000"

# JWT_SECRET: Strong random secret key used for signing authentication tokens
JWT_SECRET="YOUR_SECURE_RANDOM_JWT_SECRET_KEY"

# Database Configuration (MySQL 8.0+)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="1234"
DB_NAME="mrtechlms"

# Storage Configuration (Optional: defaults to ./assets at project root)
STORAGE_LOCAL_ROOT=""

# Email Configuration
EMAIL_ENABLED="false"                     # Set to true to send real emails, false defaults to safe mock/log
EMAIL_PROVIDER="mock"                     # mock | smtp | console
EMAIL_FROM="MRTECHLMS Notifications <notifications@mrtechlms.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"

# Optional: Seed default development admin when booting on an empty database
SEED_DEV_ADMIN="false"
